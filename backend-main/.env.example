# backend-main — mẫu biến môi trường. Copy thành .env (không commit .env) rồi điền giá trị thật.
# Quy tắc: CLAUDE.md §7 — không hard-code giá trị nhạy cảm; biến không thể lộ thì để trống + đọc hướng dẫn.

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transflow_mini
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── RabbitMQ (pipeline media.stage.* — System_Architecture.md §2) ──
# Chưa có listener/publisher ở iteration này; Spring chỉ khởi tạo ConnectionFactory.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=transflow
RABBITMQ_PASSWORD=transflow

# ── JWT (ký access/refresh token) ──
# BẮT BUỘC đổi ở môi trường thật. Sinh 1 secret ngẫu nhiên (base64, >=32 byte), ví dụ:
#   openssl rand -base64 32
# Để trống ở local sẽ dùng fallback dev-only định nghĩa sẵn trong AppProperties (không dùng cho production).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=transflow

# ── Google OAuth2 (đăng nhập Google) ──
# Lấy Client ID/Secret tại Google Cloud Console:
# https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID
# (Application type: Web application; Authorized redirect URI phải khớp GOOGLE_REDIRECT_URI bên dưới).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Frontend / CORS ──
FE_ORIGIN=http://localhost:5173

# ── Credit (SRS §5.6) ──
CREDIT_INITIAL_GRANT_AMOUNT=100.0000

# ── Media object storage (MinIO — SRS §5.2, Database_Design.md §6) ──
# Local dev mặc định trỏ vào MinIO chạy qua docker-compose (root user/password minioadmin).
# Đổi ACCESS_KEY/SECRET_KEY ở môi trường thật, không dùng giá trị mặc định ở production.
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=minioadmin
MEDIA_STORAGE_BUCKET=transflow-media

# ── Worker callback HMAC (backend-media-worker -> backend-main, API_Contract.md §14) ──
# BẮT BUỘC đổi ở môi trường thật, phải khớp đúng secret cấu hình bên backend-media-worker.
# Sinh 1 secret ngẫu nhiên (base64, >=32 byte), ví dụ: openssl rand -base64 32
# Để trống ở local sẽ dùng fallback dev-only định nghĩa sẵn trong AppProperties (không dùng cho production).
MEDIA_WORKER_HMAC_SECRET=

# ── BYOK Crypto (Mã hoá API key AES-256-GCM — CLAUDE.md §7, Database_Design.md §5) ──
# BẮT BUỘC đổi ở môi trường thật. Sinh 1 secret ngẫu nhiên (base64, 32 bytes), ví dụ:
#   openssl rand -base64 32
# Để trống ở local sẽ dùng fallback dev-only định nghĩa trong AppProperties.
PROVIDER_KEY_ENC_SECRET=

# ── AI Gateway (FastAPI backend-ai — System_Architecture.md §1) ──
# URL trỏ tới FastAPI AI service. Mặc định local dev: http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
