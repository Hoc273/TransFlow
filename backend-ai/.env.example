# ==============================================================================
# TRANSFLOW BACKEND AI (FASTAPI) — ENVIRONMENT CONFIGURATION (.env.example)
# Note: backend-ai also loads ../.env automatically if present.
# ==============================================================================

# Server & Version
AI_SERVICE_PORT=8000
APP_VERSION=0.2.0

# MinIO S3 Object Storage
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=minioadmin
MEDIA_STORAGE_BUCKET=transflow-media
MEDIA_STORAGE_SECURE=false

# Demucs Audio Separation (CT7.1)
SEPARATION_ENGINE_ID=local_demucs
SEPARATION_MODEL_ID=htdemucs
SEPARATION_DEMUCS_EXECUTABLE=python
SEPARATION_CPU_FALLBACK=true
SEPARATION_MAX_INPUT_BYTES=524288000
SEPARATION_MAX_INPUT_DURATION_MS=1800000
SEPARATION_MAX_OUTPUT_SIZE_MULTIPLIER=3
SEPARATION_EXECUTION_TIMEOUT_SECONDS=900
SEPARATION_MAX_CONCURRENT_JOBS=1

# Generated Asset Cache (ADR-CEP)
GEN_CACHE_ENABLED=true
GEN_CACHE_CAP_BYTES=1073741824
GEN_CACHE_SWEEP_INTERVAL=1800
GEN_CACHE_PREFIX=generated-assets/v1
GEN_CACHE_TTL_SECONDS=86400
GEN_CACHE_FLUSH_INTERVAL=60

# Model Execution & Token Budget Tuning
REQUEST_TIMEOUT_SECONDS=60.0
TEXT_REQUEST_TIMEOUT_SECONDS=120.0
SUMMARIZE_MAX_TOKENS=8192
NARRATIVE_SUMMARIZE_MAX_TOKENS=8192
TRANSLATE_MAX_TOKENS=8192
DISABLE_THINKING_FOR_SUMMARIZE=true
DISABLE_THINKING_FOR_TRANSLATE=true
MAX_RETRIES=3
BACKOFF_BASE_MS=250
MOCK_MODE=false

# Visual Understanding & Image Provider (VLM)
VISUAL_INTERVAL_MS=3000
VISUAL_MAX_FRAMES=12
VISUAL_SCENE_AWARE=true
VISUAL_SCENE_THRESHOLD=0.3
VISUAL_MAX_TOTAL_IMAGE_TOKENS=12000
VISUAL_COST_PER_IMAGE_TOKENS=800
VISUAL_PROMPT_VERSION=v1
VISUAL_PRICE_PER_1K_TOKENS_USD=0.005
IMAGE_PROVIDER_ENABLED=true
IMAGE_PROVIDER_TYPE=openai_compatible
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=
IMAGE_PROVIDER_TIMEOUT_MS=60000
IMAGE_PROVIDER_MAX_FRAMES=12
IMAGE_PROVIDER_INTERVAL_MS=3000

# Logging & Diagnostic Debug
LOG_LEVEL=INFO
DEBUG_LLM_WIRE=false

# Service auth: chỉ nhận request có header X-Internal-Token khớp giá trị này (gửi từ backend-main).
# Rỗng = tắt kiểm tra (chỉ dev). Production: đặt cùng giá trị cho cả 3 service.
INTERNAL_SERVICE_TOKEN=
