# ==============================================================================
# TRANSFLOW — PRODUCTION ENV (mẫu). Bản thật: dán TOÀN BỘ nội dung vào GitHub secret ENV_PROD.
# CD ghi nó thành /opt/transflow/.env trên server; docker-compose.prod.yml đọc để nội suy.
# KHÔNG commit bản có giá trị thật. Tránh ký tự `$` trong giá trị (compose hiểu là biến).
# URL nội bộ giữa các container (DB_HOST, AI_SERVICE_URL, ...) đã cố định trong compose.
# ==============================================================================

# ── Domain & TLS (DNS A record của cả 2 domain phải trỏ về IP server trước lần deploy đầu) ──
DOMAIN=transflow.example.com
# Redirect 301 về DOMAIN (cần DNS record riêng; để trống = www.<DOMAIN>).
WWW_DOMAIN=www.transflow.example.com
# MinIO công khai cho presigned URL (video/ảnh/file tải về) — subdomain riêng.
STORAGE_DOMAIN=storage.transflow.example.com
# Email nhận thông báo hết hạn chứng chỉ Let's Encrypt.
CERTBOT_EMAIL=admin@example.com
# Cổng host (chỉ 127.0.0.1) mà nginx host proxy vào.
FRONTEND_PORT=8081
MINIO_PORT=9000

# ── PostgreSQL ──
POSTGRES_USER=transflow
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=transflow

# ── Redis ──
# openssl rand -hex 24
REDIS_PASSWORD=

# ── RabbitMQ ──
RABBITMQ_USER=transflow
# openssl rand -hex 24
RABBITMQ_PASSWORD=

# ── MinIO ──
MINIO_ROOT_USER=transflow
# openssl rand -hex 24
MINIO_ROOT_PASSWORD=
MINIO_MEDIA_BUCKET=transflow-media

# ── Secrets ứng dụng (STRICT_SECRETS=true: backend-main từ chối khởi động nếu yếu/mặc định) ──
# openssl rand -base64 48
JWT_SECRET=
# AES-GCM cho API key BYOK. ĐỪNG đổi sau khi đã có dữ liệu (key cũ sẽ không giải mã được).
# openssl rand -base64 32
PROVIDER_KEY_ENC_SECRET=
# openssl rand -hex 32
MEDIA_WORKER_CALLBACK_SECRET=
# openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# openssl rand -hex 32 (giữ cố định)
FREELLMAPI_ENCRYPTION_KEY=

# ── Google OAuth (Authorized redirect URI: https://<DOMAIN>/api/auth/google/callback) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP (Gmail App Password) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Platform Super Admin (email phải đăng ký tài khoản trước, rồi deploy lại) ──
PLATFORM_ADMIN_SEED_ON_STARTUP=false
PLATFORM_ADMIN_EMAILS=

# ── FreeLLMAPI (tạo key trong dashboard qua SSH tunnel sau lần deploy đầu) ──
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_CAPABILITIES=TRANSLATE
FREELLMAPI_PRIORITY=10

# ── Tuỳ chỉnh (có mặc định trong compose) ──
CREDIT_INITIAL_GRANT_AMOUNT=100.0000
MEDIA_RETENTION=P3D
LOG_LEVEL=INFO
# Tài nguyên (mặc định cho VPS 4 vCPU / 8GB — xem đầu docker-compose.prod.yml).
# MEDIA_WORKER_CPUS=3
# MEDIA_WORKER_MEM_LIMIT=2560m
# BACKEND_AI_CPUS=2
# BACKEND_AI_MEM_LIMIT=1536m
# RAM container backend-main (heap JVM = 75%).
# BACKEND_MEM_LIMIT=2g
# RAM JVM backend-main (mặc định 75% RAM container).
# BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
