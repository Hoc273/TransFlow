# ==============================================================================
# TRANSFLOW MEDIA STUDIO — UNIFIED ROOT ENVIRONMENT CONFIGURATION (.env.example)
# Architecture: Spring Boot Core + FastAPI Gateway + Python Media Worker + React 19 Frontend
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ==============================================================================
# 1. DOCKER INFRASTRUCTURE & SHARED SERVICES
# ==============================================================================
# --- PostgreSQL 16 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transflow_mini
POSTGRES_PORT=5432

# Mọi cổng hạ tầng trong docker-compose chỉ bind địa chỉ này (mặc định 127.0.0.1 = không public).
BIND_ADDR=127.0.0.1

# --- Redis 7 (Cache, Session, Summarization Refine) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Bắt buộc ở production (docker-compose bật requirepass khi có giá trị): openssl rand -base64 32
REDIS_PASSWORD=

# --- RabbitMQ 3.13 (Pipeline Dispatch) ---
RABBITMQ_HOST=localhost
RABBITMQ_USER=transflow
RABBITMQ_PASSWORD=transflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO S3 Object Storage (Media Assets & Generated Artifacts) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MEDIA_BUCKET=transflow-media

# ==============================================================================
# 2. BACKEND MAIN (SPRING BOOT — CORE ORCHESTRATOR) [Port: 8080]
# ==============================================================================
# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transflow_mini
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT (HMAC-SHA256, >=32 bytes): openssl rand -base64 48
JWT_SECRET=

# ── Hardening (docs/Security_Hardening.md) ──
# true ở production: backend-main TỪ CHỐI khởi động nếu còn secret mặc định/yếu
# (JWT_SECRET, PROVIDER_KEY_ENC_SECRET, MEDIA_WORKER_CALLBACK_SECRET, INTERNAL_SERVICE_TOKEN,
#  MinIO/DB/RabbitMQ password mặc định).
STRICT_SECRETS=false
# Token dùng chung backend-main -> backend-ai / media-worker (header X-Internal-Token).
# Cả 3 service đọc cùng biến này. Rỗng = tắt kiểm tra (chỉ dev): openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# true khi chạy sau proxy TLS: redirect HTTP -> HTTPS (trừ /internal/** và health).
REQUIRE_HTTPS=false
# Refresh token nằm trong cookie HttpOnly; Secure=true (localhost vẫn chạy được vì là secure context).
AUTH_COOKIE_SECURE=true
# Khoá tài khoản sau N lần sai mật khẩu trong LOGIN_LOCK_DURATION (ISO-8601).
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=PT15M
# Giới hạn theo IP cho login/register/OTP/forgot-password/google-exchange.
AUTH_THROTTLE_MAX_REQUESTS=30
AUTH_THROTTLE_WINDOW=PT5M
# native = tin X-Forwarded-* chỉ từ proxy mạng nội bộ (lấy IP/scheme thật sau nginx).
FORWARD_HEADERS_STRATEGY=native
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=transflow

# Google OAuth2 Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Email SMTP (Gmail App Password — lấy ở https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Địa chỉ From: dạng bare email (KHÔNG kèm tên hiển thị, vd no-reply@transflow.vn).
# Để trống = dùng MAIL_USERNAME làm sender (đúng cho Gmail). Đặt khi dùng SMTP relay
# (SES/SendGrid/Mailgun) có username kiểu apikey — phải là địa chỉ đã verify SPF/DKIM.
MAIL_FROM=

# Frontend Origin & CORS
FE_ORIGIN=http://localhost:5173

# Initial Credit Allocation
CREDIT_INITIAL_GRANT_AMOUNT=100.0000

# MinIO Client for Spring Boot
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=minioadmin
MEDIA_STORAGE_BUCKET=transflow-media
# Hạn sống (giây) của presigned URL tải kết quả export; không nhạy cảm, mặc định 3600
MEDIA_STORAGE_PRESIGNED_TTL_SECONDS=3600
# Địa chỉ MinIO mà TRÌNH DUYỆT truy cập được (link tải được ký theo host này). Để trống = dùng MEDIA_STORAGE_ENDPOINT.
# Bắt buộc đặt khi backend chạy trong docker (MEDIA_STORAGE_ENDPOINT=http://minio:9000), vd http://localhost:9000 khi dev,
# https://<domain lưu trữ công khai> khi deploy.
MEDIA_STORAGE_PUBLIC_ENDPOINT=

# Giới hạn Media Job (không nhạy cảm; bỏ trống/không khai báo = dùng mặc định trong application.yaml)
# Số segment phụ đề tối đa mỗi lần PUT /segments/batch (mặc định 200)
MEDIA_MAX_BATCH_SUBTITLE_UPDATES=200
# Số video tối đa mỗi lần tải zip POST /projects/{id}/media/jobs/download (mặc định 20)
MEDIA_MAX_BULK_DOWNLOAD=20
# Ngôn ngữ nguồn cho phép ở override-source-lang, mã ISO 639-1 ngăn cách bằng dấu phẩy.
# TODO: danh sách mặc định là tạm thời, chờ dev chốt.
MEDIA_SUPPORTED_SOURCE_LANGS=vi,en,zh,ja,ko,fr,de,es,th,id,ru

# Worker callback HMAC (backend-media-worker -> backend-main, API_Contract.md §14)
# BẮT BUỘC đổi ở môi trường thật, phải khớp đúng secret cấu hình bên backend-media-worker.
# Sinh 1 secret ngẫu nhiên (base64, >=32 byte), ví dụ: openssl rand -base64 32
MEDIA_WORKER_CALLBACK_SECRET=CHANGE_ME

# URL nội bộ của backend-media-worker — backend-main dùng để probe GET /health
# phục vụ GET /api/transformation/capabilities (không nhạy cảm).
# Dev (backend chạy trên host): http://localhost:8001 ; trong docker network: http://media-worker:8000
MEDIA_WORKER_URL=http://localhost:8001

# Tuỳ chỉnh GET /api/transformation/capabilities (không nhạy cảm):
# TTL cache kết quả projection (giây, mặc định 5) và timeout probe /health (ms, mặc định 2000)
TRANSFORMATION_CAPABILITIES_CACHE_TTL_SECONDS=5
HEALTH_PROBE_TIMEOUT_MS=2000

# BYOK Crypto (Mã hoá API key AES-256-GCM — CLAUDE.md §7, Database_Design.md §5)
# BẮT BUỘC đổi ở môi trường thật. Sinh 1 secret ngẫu nhiên (base64, 32 bytes), ví dụ:
#   openssl rand -base64 32
PROVIDER_KEY_ENC_SECRET=CHANGE_ME

# AI Gateway (FastAPI backend-ai) URL
AI_SERVICE_URL=http://localhost:8000

# Cronjob bảo trì (@Scheduled trong backend-main). MAINTENANCE_ENABLED=false tắt toàn bộ.
MAINTENANCE_ENABLED=true
# Mọi file media (video gốc, audio, stem, TTS, render, preview) bị xoá sau thời hạn này (ISO-8601).
MEDIA_RETENTION=P3D
# Chu kỳ kiểm tra sức khoẻ key trong pool platform (test auth + probe từng capability).
PLATFORM_PROVIDER_CHECK_INTERVAL=PT30M

# FreeLLMAPI — pool LLM miễn phí tự host (service `freellmapi` trong docker-compose).
# Khóa mã hoá của chính FreeLLMAPI (giữ cố định, sinh 1 lần): openssl rand -hex 32
FREELLMAPI_ENCRYPTION_KEY=
# Bật service freellmapi khi `docker compose up` (bỏ trống nếu không dùng).
# COMPOSE_PROFILES=freellmapi
FREELLMAPI_PORT=3001
# API key "freellmapi-..." tạo trong dashboard FreeLLMAPI. Có giá trị => backend-main tự đăng ký
# 1 key FREE vào pool platform lúc khởi động (chỉ tạo 1 lần, sau đó sửa ở Super Admin → AI providers).
FREELLMAPI_API_KEY=
# URL mà container backend-ai gọi tới (không phải URL của host).
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
# "auto" = router tự chọn model. Nên ghim 1 model cụ thể để bản dịch ổn định văn phong.
FREELLMAPI_MODEL=auto
# FreeLLMAPI chỉ nên phục vụ LLM (TRANSLATE = dịch + tóm tắt + QA). Có thể thêm VISION.
FREELLMAPI_CAPABILITIES=TRANSLATE
# Số nhỏ = ưu tiên. 10 => dùng FreeLLMAPI trước, key trả phí (mặc định 100) làm dự phòng.
FREELLMAPI_PRIORITY=10

# Rate limit nghe thử giọng TTS (POST /api/tts-voices/preview): tối đa N request / cửa sổ
# WINDOW_SECONDS giây, áp theo từng user. Không nhạy cảm — chỉnh theo nhu cầu.
VOICE_PREVIEW_RATE_LIMIT_MAX_REQUESTS=5
VOICE_PREVIEW_RATE_LIMIT_WINDOW_SECONDS=60

# Rate limit gửi OTP quên mật khẩu (POST /api/auth/forgot-password/otp): tối đa N request /
# cửa sổ WINDOW_SECONDS giây, áp theo từng email. Không nhạy cảm — chỉnh theo nhu cầu.
FORGOT_OTP_RATE_LIMIT_MAX_REQUESTS=5
FORGOT_OTP_RATE_LIMIT_WINDOW_SECONDS=600

# Platform Super Admin (SRS §5.8, API_Contract §13.1 — /api/platform/*)
# Bật seed + liệt kê email tài khoản nội bộ (CSV) được cấp cờ users.is_platform_admin
# lúc backend-main khởi động. Grant-only: không tự tạo user, không revoke.
# Email phải là tài khoản đã đăng ký trong hệ thống, ví dụ:
#   PLATFORM_ADMIN_EMAILS=admin@transflow.local,ops@transflow.local
PLATFORM_ADMIN_SEED_ON_STARTUP=false
PLATFORM_ADMIN_EMAILS=

# ==============================================================================
# 3. BACKEND AI (FASTAPI — STATELESS AI GATEWAY) [Port: 8000]
# ==============================================================================
AI_SERVICE_PORT=8000
APP_VERSION=0.2.0

# Demucs Local Audio Separation
SEPARATION_ENGINE_ID=local_demucs
SEPARATION_MODEL_ID=htdemucs
SEPARATION_DEMUCS_EXECUTABLE=python
SEPARATION_CPU_FALLBACK=true
SEPARATION_MAX_CONCURRENT_JOBS=1

# Generated Asset Cache (ADR-CEP)
GEN_CACHE_ENABLED=true
GEN_CACHE_CAP_BYTES=1073741824
GEN_CACHE_SWEEP_INTERVAL=1800
GEN_CACHE_PREFIX=generated-assets/v1
GEN_CACHE_TTL_SECONDS=86400
GEN_CACHE_FLUSH_INTERVAL=60

# Model execution tuning
REQUEST_TIMEOUT_SECONDS=60.0
TEXT_REQUEST_TIMEOUT_SECONDS=120.0
SUMMARIZE_MAX_TOKENS=8192
NARRATIVE_SUMMARIZE_MAX_TOKENS=8192
TRANSLATE_MAX_TOKENS=8192
DISABLE_THINKING_FOR_SUMMARIZE=true
DISABLE_THINKING_FOR_TRANSLATE=true
MAX_RETRIES=3
BACKOFF_BASE_MS=250
MOCK_MODE=false

# Piper Local TTS (zero-key engine)
PIPER_SEMAPHORE=2
PIPER_VOICES_DIR=piper/voices

# Visual Understanding & Image Provider (VLM)
VISUAL_INTERVAL_MS=3000
VISUAL_MAX_FRAMES=12
VISUAL_SCENE_AWARE=true
VISUAL_SCENE_THRESHOLD=0.3
VISUAL_MAX_TOTAL_IMAGE_TOKENS=12000
VISUAL_COST_PER_IMAGE_TOKENS=800
VISUAL_PROMPT_VERSION=v1
VISUAL_PRICE_PER_1K_TOKENS_USD=0.005
IMAGE_PROVIDER_ENABLED=true
IMAGE_PROVIDER_TYPE=openai_compatible
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=
IMAGE_PROVIDER_TIMEOUT_MS=60000
IMAGE_PROVIDER_MAX_FRAMES=12
IMAGE_PROVIDER_INTERVAL_MS=3000

# Logging & Diagnostic Debug
LOG_LEVEL=INFO
DEBUG_LLM_WIRE=false

# ==============================================================================
# 4. BACKEND MEDIA WORKER (PYTHON + FFMPEG) [Port: 8001]
# ==============================================================================
MEDIA_WORKER_PORT=8001
MEDIA_WORKER_URL=http://localhost:8001
MEDIA_WORKER_MINIO_ENDPOINT=http://localhost:9000
MEDIA_WORKER_MINIO_ACCESS_KEY=minioadmin
MEDIA_WORKER_MINIO_SECRET_KEY=minioadmin
MEDIA_WORKER_MEDIA_BUCKET=transflow-media
MEDIA_WORKER_CALLBACK_BASE_URL=http://localhost:8080
MEDIA_WORKER_REVISION=unknown
MEDIA_WORKER_VALIDATION_DURATION_TOLERANCE_MS=500
MEDIA_WORKER_VALIDATION_DURATION_TOLERANCE_PCT=2.0
MEDIA_WORKER_RENDER_MAX_CONCURRENCY=1
MEDIA_WORKER_SUBTITLE_FONTS_DIR=/usr/share/fonts/truetype/dejavu
MEDIA_WORKER_LOG_LEVEL=INFO

# ==============================================================================
# 5. FRONTEND (REACT 19 + VITE + TAILWIND CSS V4) [Port: 5173]
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api
# Dev proxy target when VITE_API_BASE_URL=/api (vite.config.ts)
VITE_BACKEND_URL=http://localhost:8080
VITE_DEFAULT_LANGUAGE=vi
VITE_ENABLE_GLOBAL_SEARCH=false
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_QA_OVERRIDE=true
VITE_ENABLE_NARRATIVE_REVIEW_AI=true
