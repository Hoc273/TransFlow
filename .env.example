# ==============================================================================
# TRANSFLOW MEDIA STUDIO — UNIFIED ROOT ENVIRONMENT CONFIGURATION (.env.example)
# Architecture: Spring Boot Core + FastAPI Gateway + Python Media Worker + React 19 Frontend
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ==============================================================================
# 1. DOCKER INFRASTRUCTURE & SHARED SERVICES
# ==============================================================================
# --- PostgreSQL 16 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transflow_mini
POSTGRES_PORT=5432

# --- Redis 7 (Cache, Session, Summarization Refine) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ 3.13 (Pipeline Dispatch) ---
RABBITMQ_HOST=localhost
RABBITMQ_USER=transflow
RABBITMQ_PASSWORD=transflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO S3 Object Storage (Media Assets & Generated Artifacts) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MEDIA_BUCKET=transflow-media

# ==============================================================================
# 2. BACKEND MAIN (SPRING BOOT — CORE ORCHESTRATOR) [Port: 8080]
# ==============================================================================
# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transflow_mini
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT (HMAC-SHA256, >=32 bytes)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=transflow

# Google OAuth2 Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Email SMTP (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="TransFlow <no-reply@transflow.local>"

# Frontend Origin & CORS
FE_ORIGIN=http://localhost:5173

# Initial Credit Allocation
CREDIT_INITIAL_GRANT_AMOUNT=100.0000

# MinIO Client for Spring Boot
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=minioadmin
MEDIA_STORAGE_BUCKET=transflow-media
# Hạn sống (giây) của presigned URL tải kết quả export; không nhạy cảm, mặc định 3600
MEDIA_STORAGE_PRESIGNED_TTL_SECONDS=3600
# Địa chỉ MinIO mà TRÌNH DUYỆT truy cập được (link tải được ký theo host này). Để trống = dùng MEDIA_STORAGE_ENDPOINT.
# Bắt buộc đặt khi backend chạy trong docker (MEDIA_STORAGE_ENDPOINT=http://minio:9000), vd http://localhost:9000 khi dev,
# https://<domain lưu trữ công khai> khi deploy.
MEDIA_STORAGE_PUBLIC_ENDPOINT=

# Worker callback HMAC (backend-media-worker -> backend-main, API_Contract.md §14)
# BẮT BUỘC đổi ở môi trường thật, phải khớp đúng secret cấu hình bên backend-media-worker.
# Sinh 1 secret ngẫu nhiên (base64, >=32 byte), ví dụ: openssl rand -base64 32
MEDIA_WORKER_HMAC_SECRET=CHANGE_ME

# BYOK Crypto (Mã hoá API key AES-256-GCM — CLAUDE.md §7, Database_Design.md §5)
# BẮT BUỘC đổi ở môi trường thật. Sinh 1 secret ngẫu nhiên (base64, 32 bytes), ví dụ:
#   openssl rand -base64 32
PROVIDER_KEY_ENC_SECRET=CHANGE_ME

# AI Gateway (FastAPI backend-ai) URL
AI_SERVICE_URL=http://localhost:8000

# ==============================================================================
# 3. BACKEND AI (FASTAPI — STATELESS AI GATEWAY) [Port: 8000]
# ==============================================================================
AI_SERVICE_PORT=8000
APP_VERSION=0.2.0

# Demucs Local Audio Separation
SEPARATION_ENGINE_ID=local_demucs
SEPARATION_MODEL_ID=htdemucs
SEPARATION_DEMUCS_EXECUTABLE=python
SEPARATION_MAX_CONCURRENT_JOBS=1

# Generated Asset Cache (ADR-CEP)
GEN_CACHE_ENABLED=true
GEN_CACHE_CAP_BYTES=1073741824
GEN_CACHE_SWEEP_INTERVAL=1800
GEN_CACHE_PREFIX=generated-assets/v1
GEN_CACHE_TTL_SECONDS=86400
GEN_CACHE_FLUSH_INTERVAL=60

# Model execution tuning
REQUEST_TIMEOUT_SECONDS=60.0
TEXT_REQUEST_TIMEOUT_SECONDS=120.0
MOCK_MODE=false

# ==============================================================================
# 4. BACKEND MEDIA WORKER (PYTHON + FFMPEG) [Port: 8001]
# ==============================================================================
MEDIA_WORKER_PORT=8001
MEDIA_WORKER_MINIO_ENDPOINT=http://localhost:9000
MEDIA_WORKER_MINIO_ACCESS_KEY=minioadmin
MEDIA_WORKER_MINIO_SECRET_KEY=minioadmin
MEDIA_WORKER_MEDIA_BUCKET=transflow-media
MEDIA_WORKER_CALLBACK_SECRET=change-me
MEDIA_WORKER_CALLBACK_BASE_URL=http://localhost:8080
MEDIA_WORKER_REVISION=unknown
MEDIA_WORKER_VALIDATION_DURATION_TOLERANCE_MS=500
MEDIA_WORKER_VALIDATION_DURATION_TOLERANCE_PCT=2.0

# ==============================================================================
# 5. FRONTEND (REACT 19 + VITE + TAILWIND CSS V4) [Port: 5173]
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEFAULT_LANGUAGE=vi
VITE_ENABLE_GLOBAL_SEARCH=false
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_QA_OVERRIDE=true
VITE_ENABLE_NARRATIVE_REVIEW_AI=true
