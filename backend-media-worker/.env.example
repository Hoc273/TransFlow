# ==============================================================================
# TRANSFLOW BACKEND MEDIA WORKER (PYTHON + FFMPEG) — ENVIRONMENT CONFIGURATION (.env.example)
# Note: backend-media-worker also loads ../.env automatically if present.
# ==============================================================================

MEDIA_WORKER_PORT=8001
MEDIA_WORKER_MINIO_ENDPOINT=http://localhost:9000
MEDIA_WORKER_MINIO_ACCESS_KEY=minioadmin
MEDIA_WORKER_MINIO_SECRET_KEY=minioadmin
MEDIA_WORKER_MEDIA_BUCKET=transflow-media

# Callback authentication to backend-main (HMAC-SHA256, API_Contract.md §14)
# Must match MEDIA_WORKER_CALLBACK_SECRET in backend-main.
MEDIA_WORKER_CALLBACK_SECRET=change-me
MEDIA_WORKER_CALLBACK_BASE_URL=http://localhost:8080

# Deployment revision (git SHA or version)
MEDIA_WORKER_REVISION=unknown

# Technical validation tolerances
MEDIA_WORKER_VALIDATION_DURATION_TOLERANCE_MS=500
MEDIA_WORKER_VALIDATION_DURATION_TOLERANCE_PCT=2.0

# Concurrency & Subtitles
MEDIA_WORKER_RENDER_MAX_CONCURRENCY=1
MEDIA_WORKER_SUBTITLE_FONTS_DIR=/usr/share/fonts/truetype/dejavu

# Logging
MEDIA_WORKER_LOG_LEVEL=INFO
