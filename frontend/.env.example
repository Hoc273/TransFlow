VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_GLOBAL_SEARCH=false
# Google OAuth (07 Q-AUTH-G*, 09b B.1b) — set true when BE Auth-OAuth is deployed with credentials.
VITE_ENABLE_GOOGLE_AUTH=true
# QA Override (06b §6.1) — BE endpoint ready; FE modal now shipped.
VITE_ENABLE_QA_OVERRIDE=true
# CT5.4b Narrative Review UI. Keep aligned with backend NARRATIVE_REVIEW_AI_ENABLED.
VITE_ENABLE_NARRATIVE_REVIEW_AI=true
