# TransFlow — nginx trên host: terminate TLS, proxy vào container chỉ bind 127.0.0.1.
# deploy/server-deploy.sh thay __DOMAIN__ / __WWW_DOMAIN__ / __STORAGE_DOMAIN__ / __FRONTEND_PORT__ / __MINIO_PORT__
# rồi ghi vào /etc/nginx/conf.d/transflow.conf. Chứng chỉ Let's Encrypt (1 cert cho cả 3 domain)
# nằm ở /etc/letsencrypt/live/transflow/, gia hạn bằng certbot timer qua webroot bên dưới.

# ── Chống lạm dụng / L7 flood theo IP client ──
# File nằm trong conf.d nên các zone này ở ngữ cảnh http. $binary_remote_addr là IP thật
# (DNS only: IP kết nối; bật proxy Cloudflare: realip lấy từ CF-Connecting-IP).
# Chỉ chặn được flood từ ít IP; volumetric DDoS (băng thông / SYN flood) phải chặn ở tầng
# mạng (Cloudflare proxy / AWS Shield) — nginx không cứu được khi đường truyền đã bão hoà.
#
# Nhiều người dùng chung 1 IP (CGNAT nhà mạng di động, văn phòng, phòng lab trường) là bình thường,
# nên /api giới hạn 2 tầng:
#   - tf_user_*: theo người dùng — khoá là chữ ký JWT trong Authorization (≤ 86 ký tự với HS512,
#     dưới giới hạn 255 byte của khoá limit_conn); request chưa đăng nhập dùng IP. Vượt ngưỡng chỉ
#     trả 429 cho đúng người đó, fail2ban KHÔNG tính (chặn IP sẽ chặn luôn cả mạng dùng chung).
#   - tf_api / tf_conn: trần theo IP, rộng hơn nhiều — đủ cho cả chục người sau 1 NAT, nhưng vẫn
#     chặn kẻ gửi token giả ngẫu nhiên để lách giới hạn theo người dùng. fail2ban tính vùng này.
map $http_authorization $tf_user_key {
    "~^Bearer [A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.(?<tf_jwt_sig>[A-Za-z0-9_-]{16,128})$" $tf_jwt_sig;
    default $binary_remote_addr;
}
limit_req_zone  $tf_user_key        zone=tf_user_api:10m    rate=20r/s;
limit_conn_zone $tf_user_key        zone=tf_user_upload:10m;
limit_req_zone  $binary_remote_addr zone=tf_api:10m         rate=100r/s;
limit_req_zone  $binary_remote_addr zone=tf_auth:10m        rate=30r/m;
limit_req_zone  $binary_remote_addr zone=tf_storage:10m     rate=30r/s;
limit_conn_zone $binary_remote_addr zone=tf_conn:10m;
limit_req_status  429;
limit_conn_status 429;

# Slowloris: đóng kết nối gửi header/body quá chậm (body timeout là khoảng nghỉ giữa 2 lần đọc,
# không phải tổng thời gian upload nên upload chậm nhưng liên tục vẫn chạy).
client_header_timeout 15s;
client_body_timeout   30s;
send_timeout          60s;

# HTTP: chỉ phục vụ ACME challenge (gia hạn cert), còn lại redirect HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __WWW_DOMAIN__ __STORAGE_DOMAIN__;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── www -> apex ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __WWW_DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/transflow/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/transflow/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TransflowSSL:10m;
    ssl_session_timeout 1d;

    return 301 https://__DOMAIN__$request_uri;
}

# ── App: SPA + /api (frontend container proxy /api sang backend-main) ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/transflow/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/transflow/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TransflowSSL:10m;
    ssl_session_timeout 1d;

    # 10MB cho mọi path: video đi theo chunk 8MB. Không mở body lớn ở đâu cả — nginx đệm body ra
    # đĩa trước khi Spring kiểm tra JWT, nên body lớn cho phép người chưa đăng nhập làm đầy đĩa.
    client_max_body_size 10m;
    # KHÔNG tắt proxy_request_buffering ở đây: với HTTP/2 + unbuffered, nginx chỉ mở cửa sổ
    # flow-control bằng client_body_buffer_size mỗi RTT => upload chỉ ~100-200KB/s. Đệm ra đĩa
    # (EBS nhanh) rồi đẩy qua loopback; frontend nginx phía sau stream thẳng sang Spring.
    client_body_buffer_size 1m;
    proxy_connect_timeout 30s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    # HTTP/2: mỗi stream đang chạy tính là 1 kết nối. Trần theo IP, chừa chỗ cho nhiều người sau 1 NAT.
    limit_conn tf_conn 128;

    # Callback worker chỉ đi trong docker network, không bao giờ qua cổng public.
    location /internal/ {
        return 404;
    }

    # Upload video chia chunk 8MB (PUT .../media/uploads/{id}/chunks/{n}) — lọt dưới 10MB ở trên.
    # Tối đa 12 chunk đang gửi / người dùng (FE gửi song song 3 mỗi tab => đủ 4 tab). Domain để DNS
    # only: qua proxy Cloudflare Free, người dùng Viettel chỉ upload được 7–90KB/s
    # (docs/Deployment_Network.md §6.3).
    location ~ ^/api/workspaces/[^/]+/media/uploads/[^/]+/chunks/ {
        limit_conn tf_user_upload 12;
        limit_req zone=tf_user_api burst=80 nodelay;
        limit_req zone=tf_api burst=400 nodelay;

        proxy_pass http://127.0.0.1:__FRONTEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Endpoint không cần đăng nhập mà bot hay dò (login, đăng ký, OTP). Backend còn giới hạn
    # AUTH_THROTTLE_MAX_REQUESTS lần/5 phút/IP; ở đây chặn sớm để flood không chạm tới bcrypt/Redis/SMTP.
    # Chưa đăng nhập nên chỉ có IP để phân biệt: ngưỡng đủ cho cả lớp học sau 1 NAT đăng nhập cùng
    # lúc; dò mật khẩu từng tài khoản đã bị LoginAttemptService khoá sau 5 lần sai.
    location ~ ^/api/auth/(login|register|forgot-password/|google/exchange) {
        limit_req zone=tf_auth burst=30 nodelay;

        proxy_pass http://127.0.0.1:__FRONTEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    # API còn lại (kể cả /api/auth/refresh). Burst lớn vì SPA bắn nhiều query song song khi mở trang;
    # frontend coi 429 ở refresh là lỗi tạm thời, không logout người dùng.
    location /api/ {
        limit_req zone=tf_user_api burst=80 nodelay;
        limit_req zone=tf_api burst=400 nodelay;

        proxy_pass http://127.0.0.1:__FRONTEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:__FRONTEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}

# ── Object storage: MinIO API cho presigned URL (MEDIA_STORAGE_PUBLIC_ENDPOINT) ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __STORAGE_DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/transflow/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/transflow/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TransflowSSL:10m;
    ssl_session_timeout 1d;

    # Chỉ phục vụ GET qua presigned URL (backend không cấp presigned PUT) => không nhận body lớn.
    client_max_body_size 1m;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 30s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    # Video phát/tải qua presigned URL: mỗi lần tua là 1 Range request. Giới hạn theo IP để 1 máy
    # không kéo liên tục file lớn (băng thông ra của EC2 tính tiền theo GB).
    limit_conn tf_conn 32;
    limit_req zone=tf_storage burst=100 nodelay;

    location / {
        proxy_pass http://127.0.0.1:__MINIO_PORT__;
        proxy_http_version 1.1;
        # Chữ ký presigned URL gồm Host — phải giữ nguyên host trình duyệt gửi.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        chunked_transfer_encoding off;
    }
}
